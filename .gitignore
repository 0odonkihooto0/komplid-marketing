# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# личные настройки Claude Code (общие для команды — в .claude/settings.json)
.claude/settings.local.json

# служебные маркеры хуков (память проекта — в docs/memory/, она коммитится)
.claude/.cache/

# лиды с сайта: персональные данные (email), в репозиторий попадать не должны (152-ФЗ).
# На проде каталог примонтирован томом — см. docker-compose.prod.yml
/.data/

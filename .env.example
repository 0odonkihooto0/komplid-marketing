# Аналитика
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Ссылка на основное приложение
NEXT_PUBLIC_APP_URL=https://app.komplid.ru

# API-интеграция с основным приложением (только серверный код!)
INTERNAL_API_URL=https://app.komplid.ru/api/public
INTERNAL_API_TOKEN=

# URL сайта (для sitemap, canonical, schema)
NEXT_PUBLIC_SITE_URL=https://komplid.ru

# Режим пре-лонча: "1" — регистрация закрыта, все главные CTA ведут на форму
# раннего доступа. При запуске приложения поставить "0" и пересобрать —
# кнопки сами вернутся на app.komplid.ru/signup.
NEXT_PUBLIC_WAITLIST_MODE=1

# ── Хранилище заявок ────────────────────────────────────────────────────────
# Основной прод — Timeweb App Platform, где контейнер эфемерный: файлы не
# переживают деплой. Поэтому заявки уезжают в S3. Если S3_BUCKET не задан,
# используется запись на диск (локальная разработка и запасной путь на VDS).
# Бакет обязан быть приватным: в заявках персональные данные (152-ФЗ).
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Куда складывать лиды на диске, когда S3 не настроен. На VDS — примонтированный
# том (/data), см. docker-compose.prod.yml. Локально по умолчанию ./.data.
LEADS_DATA_DIR=

# Дублирование заявок в Telegram (необязательно — без токена просто пропускается)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Реквизиты ИП (для футера и юридических страниц).
# Пустые значения — норма: в src/lib/company.ts лежат настоящие значения
# по умолчанию. Эти переменные нужны, только чтобы их переопределить.
COMPANY_NAME=
COMPANY_INN=
COMPANY_OGRNIP=
COMPANY_EMAIL=hello@komplid.ru
# Адрес для обращений по персональным данным (указан в политике конфиденциальности)
COMPANY_PRIVACY_EMAIL=

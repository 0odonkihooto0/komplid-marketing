# Shell-скрипты всегда с LF. На Windows git по умолчанию отдаёт рабочую копию
# с CRLF, и тогда bash падает на `$'\r': command not found` — хуки памяти
# и deploy.sh переставали работать бы сразу после свежего клона.
*.sh text eol=lf

# Прочие текстовые файлы — нормализация переводов строк в репозитории.
* text=auto
